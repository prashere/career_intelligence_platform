# Copy this file to .env and fill in keys. Full walkthrough: setup.md
#
# Required for CV extraction, chat, and the assistant: GROQ_API_KEY
# Optional: OPENAI_API_KEY, TAVILY_API_KEY, LANGSMITH_API_KEY, RESEND_API_KEY
# Change SECRET_KEY and BOOTSTRAP_ADMIN_PASSWORD before any shared use.

# Database
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career_intelligence
DATABASE_URL_SYNC=postgresql://career:career@localhost:5432/career_intelligence

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI — chat (Groq free tier recommended)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# CV extraction uses a higher-TPM model (gpt-oss-20b free tier = 8K TPM total per request)
GROQ_EXTRACTION_MODEL=groq/compound-mini
LLM_EXTRACTION_MAX_TOKENS=2048
LLM_EXTRACTION_MAX_CV_CHARS=5000

# LangSmith — trace LLM calls (profile CV extraction, agent chat, embeddings)
# Create key: https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-intelligence
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Embeddings / OpenAI (optional until Gemini embeddings are configured)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

TAVILY_API_KEY=
# Required for verification layer web search (Task 2)

# Source health + staleness (Tasks 5–6)
SOURCE_FAILURE_DEACTIVATE_THRESHOLD=5
STALENESS_CHECK_BATCH_SIZE=20
STALENESS_NOT_SEEN_DAYS=14
STALENESS_RECRAWL_DAYS=30

# Email (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=career@localhost
EMAIL_TO=you@example.com

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# First-run admin (created when the users table is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.dev
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# Set automatically in docker-compose for api service; leave empty for local dev
PROJECT_ROOT=

# Sentry (production)
SENTRY_DSN=
