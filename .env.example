# Database
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career_intelligence
DATABASE_URL_SYNC=postgresql://career:career@localhost:5432/career_intelligence

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI
OPENAI_API_KEY=
TAVILY_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Email (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=career@localhost
EMAIL_TO=you@example.com

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set automatically in docker-compose for api service; leave empty for local dev
PROJECT_ROOT=

# Sentry (production)
SENTRY_DSN=
